# Copiá este archivo como .env y completalo. El archivo .env NUNCA se sube a GitHub.
#   cp .env.example .env

# --- Modo ---------------------------------------------------------------
# mock = todo simulado, sin plata (para probar).  live = Celo mainnet, plata real.
MODE=mock
PORT=8402
# Dirección donde escucha. 0.0.0.0 = toda la red (por defecto). Detrás de un proxy con HTTPS (nginx, Caddy), poné 127.0.0.1.
HOST=0.0.0.0
# Dirección pública del servidor. En local queda así; para Telegram con botón de pago hace falta https
# (por ejemplo con un túnel: cloudflared tunnel --url http://localhost:8402).
PUBLIC_BASE_URL=http://localhost:8402

# --- Wallet del agente (la cuenta "agentica" de MetaMask) ----------------
# La clave se carga con el comando de la GUIA (read -s), no la escribas acá a mano si podés evitarlo.
AGENT_PRIVATE_KEY=
# Tu tag de Loops House (Celo mainnet · your entry). No es secreto.
ATTRIBUTION_TAG=celo_aa27de260db7
# Pagar el gas del agente con un stablecoin en vez de CELO: USAT, USDC o USDT (vacío = CELO)
FEE_CURRENCY=
RPC_URL=https://forno.celo.org
# Se completa después de registrar la identidad (npm run register -- --send)
ERC8004_AGENT_ID=

# --- Cobros x402 ------------------------------------------------------------
X402_FACILITATOR_URL=https://api.x402.celo.org
# Se crea en https://x402.celo.org conectando una wallet y firmando un mensaje (sin gas). Es secreta.
X402_API_KEY=
# Dónde llegan los cobros. Vacío = la wallet del agente (recomendado: así puede devolver).
PAY_TO=
# Declara tu tag en las respuestas 402 (extensión builder-code). Si el facilitador rechaza pagos, probá con false.
X402_BUILDER_CODE=true

# --- Dueño -------------------------------------------------------------------
# Adónde va el retiro diario (por ejemplo tu dirección de depósito de wARS en Ripio). Vacío = no retira.
OWNER_PAYOUT_ADDRESS=
# Hora local del cierre del día. Solo se usa la primera vez (para llenar la configuración inicial):
# después se cambia desde el panel (Configuración).
CIERRE_HORA=23:30

# --- Ticket NFT de la reserva (opcional) ----------------------------------------------------
# Al pagar la seña, el agente le manda a la billetera que pagó un NFT intransferible con los datos de la reserva
# (contracts/SenaTicket.sol). Por defecto en Celo Sepolia, una testnet: no cuesta plata real.
#   1) Conseguí fondos de prueba: https://faucet.celo.org/celo-sepolia  (a la dirección de la clave de abajo)
#   2) npm run nft:deploy            (simulación)   y después   npm run nft:deploy -- --send
#   3) Copiá acá el contrato que te muestra y reiniciá.
NFT_CONTRACT=
# Clave del NFT. En TESTNET usá una clave dedicada (npm run nft:clave): nunca la del agente del modo real. Solo si desplegás en
# Celo mainnet (NFT_CHAIN=celo) tiene que ser la clave del agente registrado, para que cada ticket lleve su tag. Es secreta.
NFT_PRIVATE_KEY=
# celoSepolia (por defecto) | sepolia | celo
NFT_CHAIN=celoSepolia
NFT_RPC_URL=
# Solo en MODE=mock y sin contrato: simula el NFT en memoria para ver el flujo (se ve como "simulado").
NFT_SIMULADO=false

# --- Panel del comercio (/panel) --------------------------------------------------
# Clave para entrar al panel (mínimo 8 caracteres). Sin esto el panel queda deshabilitado.
OWNER_DASHBOARD_PASSWORD=
# Poné true si el servidor está detrás de un túnel o proxy (cloudflared, nginx) para que el límite de intentos
# y de reservas use la IP real de cada persona. Con false, todos cuentan como una sola.
TRUST_PROXY=false

# --- Telegram ------------------------------------------------------------------
# Crealo con @BotFather. Vacío = bot apagado (los avisos salen por consola).
TELEGRAM_BOT_TOKEN=
# Tu chat id: escribile /quiensoy al bot y pegalo acá.
OWNER_CHAT_ID=

# --- Claude (opcional) -----------------------------------------------------------
# Para entender mensajes libres que las reglas no cubren. Sin esto, el bot funciona igual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Solo para scripts de prueba ----------------------------------------------------
# Wallet COMPRADORA de prueba (distinta a la del agente) para npm run pay
BUYER_PRIVATE_KEY=
